# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Claude API (teacher labeling, judge, gateway fallback) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Model IDs are confirmed against the current Anthropic docs before use.
LOGLENS_TEACHER_MODEL=claude-haiku-5-5
LOGLENS_FALLBACK_MODEL=claude-haiku-5-5
LOGLENS_JUDGE_MODEL=claude-sonnet-5-5

# --- Spend controls (applied to every script that calls Claude) ---
LOGLENS_MAX_REQUESTS=50
LOGLENS_DRY_RUN=true

# --- Local model server (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
LOGLENS_LOCAL_MODEL=loglens-qwen2.5-1.5b

# --- Gateway ---
# Comma-separated API keys accepted by the gateway (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))")
LOGLENS_API_KEYS=REPLACE_ME
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://loglens:loglens@localhost:5432/loglens

# --- Tracking / tracing ---
MLFLOW_TRACKING_URI=http://localhost:5000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Hugging Face (only needed for pushing the adapter / Space) ---
HF_TOKEN=hf_REPLACE_ME
